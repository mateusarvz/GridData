# Normalize line endings in the repository
* text=auto eol=lf

# Scripts and markup
*.sh text eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Keep binary files untouched
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.svg text eol=lf
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
*.7z binary
*.rar binary
