ENVIRONMENT=development
PROJECT_NAME=Dama Box
API_V1_STR=/api/v1

# Banco de Dados Administrativo (sistema)
DATABASE_SYSTEM_URL=postgresql+asyncpg://damabox_admin:change-me@localhost:5432/sistema

# Segurança e Autenticação
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10
REFRESH_TOKEN_EXPIRE_DAYS=30

# Redis e Storage
REDIS_URL=redis://localhost:6379/0
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=change-me
MINIO_SECRET_KEY=change-me
MINIO_BUCKET_NAME=damabox-storage

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_NAME=DamaBox API Key
GEMINI_PROJECT_NAME=projects/your-project-number
GEMINI_PROJECT_NUMBER=your-project-number
GEMINI_MODEL=gemini-3.5-flash-lite
